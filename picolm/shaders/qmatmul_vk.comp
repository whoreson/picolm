#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) readonly buffer W  { uint  w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int fmt;
    int S, I, O;
    int rowWords;
} p;

shared float xsh[7968];
shared float sg_sum[8];

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

uint read_byte(uint rowBase, uint byteOff) {
    uint wIdx = rowBase + byteOff / 4u;
    return (w[wIdx] >> ((byteOff % 4u) * 8u)) & 0xffu;
}

// Q2_K: 256 values in 84 bytes: scales[16] + qs[64] + d(fp16) + dmin(fp16)
float dequant_q2_K(uint rowBase, uint bo, int i) {
    uint d_raw = read_byte(rowBase, bo+80u) | (read_byte(rowBase, bo+81u) << 8u);
    uint dm_raw = read_byte(rowBase, bo+82u) | (read_byte(rowBase, bo+83u) << 8u);
    float d = f16tof32(d_raw);
    float dmin = f16tof32(dm_raw);
    
    int chunk = i / 128;
    int i_in_chunk = i % 128;
    int group = i_in_chunk / 16;
    int l = i_in_chunk % 16;
    int shift = (group % 4) * 2;
    int half = group / 4;
    int scale_idx = chunk * 8 + group;
    
    uint sc_byte = read_byte(rowBase, bo + uint(scale_idx));
    uint sc = sc_byte & 0xfu;
    uint mn = sc_byte >> 4u;
    
    uint qs_val = read_byte(rowBase, bo + 16u + uint(chunk*32 + half*16 + l));
    int v = int((qs_val >> shift) & 3u);
    
    return d * float(sc) * float(v) - dmin * float(mn);
}

// Q3_K: 256 values in 110 bytes: hmask[32] + qs[64] + scales[12] + d(fp16)
// Unpacks 16 six-bit scales from 12 bytes, then dequantizes per-element
float dequant_q3_K(uint rowBase, uint bo, int i) {
    // Read d (fp16 at offset 108)
    uint d_raw = read_byte(rowBase, bo+108u) | (read_byte(rowBase, bo+109u) << 8u);
    float d = f16tof32(d_raw);
    
    // Read scales[12] at offset 96, unpack into 16 six-bit values
    // scales: bytes 96..107 of block (12 bytes = 3 uint32)
    uint s0 = w[rowBase + (bo + 96u) / 4u];
    uint s1 = w[rowBase + (bo + 100u) / 4u];
    uint s2 = w[rowBase + (bo + 104u) / 4u];
    
    // Adjust for byte alignment within words
    uint bo_mod = bo % 4u;
    if (bo_mod != 0u) {
        uint shift0 = bo_mod * 8u;
        s0 = (s0 >> shift0) | (w[rowBase + (bo + 96u) / 4u + 1u] << (32u - shift0));
        s1 = (w[rowBase + (bo + 100u) / 4u] >> shift0) | (w[rowBase + (bo + 100u) / 4u + 1u] << (32u - shift0));
        s2 = (w[rowBase + (bo + 104u) / 4u] >> shift0) | (w[rowBase + (bo + 104u) / 4u + 1u] << (32u - shift0));
    }
    
    // Unpack 16 six-bit scales from 3 uint32
    // From CPU: tmp=aux[2], then:
    // aux[0] = (s0&0x0F0F0F0F) | (((s2>>0)&0x03030303)<<4)
    // aux[1] = (s1&0x0F0F0F0F) | (((s2>>2)&0x03030303)<<4)
    // aux[2] = ((s0>>4)&0x0F0F0F0F) | (((s2>>4)&0x03030303)<<4)
    // aux[3] = ((s1>>4)&0x0F0F0F0F) | (((s2>>6)&0x03030303)<<4)
    uint tmp = s2;
    uint a0 = (s0 & 0x0F0F0F0F) | ((tmp & 0x03030303) << 4);
    uint a1 = (s1 & 0x0F0F0F0F) | (((tmp >> 2) & 0x03030303) << 4);
    uint a2 = ((s0 >> 4) & 0x0F0F0F0F) | (((tmp >> 4) & 0x03030303) << 4);
    uint a3 = ((s1 >> 4) & 0x0F0F0F0F) | (((tmp >> 6) & 0x03030303) << 4);
    
    // Now a0..a3 each have 4 nibbles, each nibble is a 6-bit scale value [0..63]
    // scales[0..3] in a0, [4..7] in a1, [8..11] in a2, [12..15] in a3
    // Each 6-bit value is stored in a byte position
    
    int chunk = i / 128;              // 0..1
    int i_in_chunk = i % 128;         // 0..127
    int sub_16 = i_in_chunk / 16;     // 0..7
    int l = i_in_chunk % 16;          // 0..15
    
    // Determine which aux word and which nibble
    int aux_word = sub_16 / 4;       // 0..1 (a0/a1 for first 8, a2/a3 for second 8)
    // Wait, 8 sub-groups per chunk, 2 aux words per chunk? No.
    // 16 scales total: a0=0..3, a1=4..7, a2=8..11, a3=12..15
    int scale_idx = chunk * 8 + sub_16;  // 0..15
    
    // Extract the 6-bit scale from the appropriate aux word
    int aux_idx = scale_idx / 4;     // 0..3
    int nibble = scale_idx % 4;       // 0..3
    uint aux_val;
    if (aux_idx == 0) aux_val = a0;
    else if (aux_idx == 1) aux_val = a1;
    else if (aux_idx == 2) aux_val = a2;
    else aux_val = a3;
    int scale = int((aux_val >> (nibble * 8u)) & 0xffu);
    
    // Read quant value: 2-bit from qs, with hmask offset
    // qs layout: 64 bytes, 2 chunks of 32 bytes
    // hmask: 32 bytes
    int shift = (sub_16 % 4) * 2;    // 0,2,4,6
    int qs_half = sub_16 / 4;         // 0 or 1
    
    int qs_idx = chunk * 32 + qs_half * 16 + l;
    uint qs_val = read_byte(rowBase, bo + 32u + uint(qs_idx));  // qs at offset 32
    int q = int((qs_val >> shift) & 3u);
    
    // hmask: bit l of byte (chunk*16 + sub_16*2 + qs_half) 
    // Actually from CPU code: hm[l] & m where m starts at 1 and shifts per group
    // m <<= 1 after each pair of sub-groups (j=0: m=1, j=1: m=2, j=2: m=4, j=3: m=8)
    // Then for second chunk, m resets to 1
    int hm_byte_idx = chunk * 16 + qs_half * 8 + l;
    int hm_bit = (sub_16 % 4);  // which bit of the byte
    uint hm_byte = read_byte(rowBase, bo + uint(hm_byte_idx));  // hmask at offset 0
    int hm_bit_val = int((hm_byte >> hm_bit) & 1u);
    
    int offset = hm_bit_val ? 0 : 4;
    float val = d * float(scale - 32) * float(q - offset);
    return val;
}

void main() {
    int s   = int(gl_WorkGroupID.y);
    int tid = int(gl_LocalInvocationID.x);
    int nth = int(gl_WorkGroupSize.x);
    int sg      = int(gl_SubgroupID);
    int lane    = int(gl_SubgroupInvocationID);
    int sgsize  = int(gl_SubgroupSize);

    int o = int(gl_WorkGroupID.x);
    if (o >= p.O) return;

    bool staged = p.I <= 7968;
    if (staged) {
        for (int i = tid; i < p.I; i += nth)
            xsh[i] = x[s * p.I + i];
    }
    memoryBarrierShared();
    barrier();

    int xoff = s * p.I;
    uint rowBase = uint(o) * uint(p.rowWords);
    float sum = 0.0;

    if (p.fmt == 8) {
        // Q8_0: 34 bytes/block, 32 values/block
        int nblocks = (p.I + 31) / 32;
        for (int bi = tid; bi < nblocks; bi += nth) {
            uint bo = uint(bi) * 34u;
            uint dWord = rowBase + bo / 4u;
            uint dShift = (bo % 4u) * 8u;
            float d = f16tof32((w[dWord] >> dShift) & 0xffffu);
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v;
                if (vi >= p.I) break;
                uint bv = read_byte(rowBase, bo + 2u + uint(v));
                int val = int(bv); if (val >= 128) val -= 256;
                float xval = staged ? xsh[vi] : x[xoff + vi];
                sum += xval * float(val) * d;
            }
        }
    } else if (p.fmt == 2) {
        // Q4_0: 18 bytes/block, 32 values/block
        int nblocks = (p.I + 31) / 32;
        for (int bi = tid; bi < nblocks; bi += nth) {
            uint bo = uint(bi) * 18u;
            float d = f16tof32(read_byte(rowBase, bo) | (read_byte(rowBase, bo+1u) << 8u));
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v;
                if (vi >= p.I) break;
                uint ni = v < 16 ? uint(v) : uint(v - 16);
                uint ns = v < 16 ? 0u : 4u;
                uint bv = read_byte(rowBase, bo + 2u + ni);
                int val = int((bv >> ns) & 0xfu) - 8;
                float xval = staged ? xsh[vi] : x[xoff + vi];
                sum += xval * float(val) * d;
            }
        }
    } else if (p.fmt == 1) {
        // F16
        for (int i = tid; i < p.I; i += nth) {
            float xval = staged ? xsh[i] : x[xoff + i];
            sum += xval * f16tof32(read_byte(rowBase, uint(i)*2u) | (read_byte(rowBase, uint(i)*2u+1u) << 8u));
        }
    } else if (p.fmt == 0) {
        // F32
        for (int i = tid; i < p.I; i += nth) {
            float xval = staged ? xsh[i] : x[xoff + i];
            sum += xval * uintBitsToFloat(w[rowBase + uint(i)]);
        }
    } else if (p.fmt == 10) {
        // Q2_K: 84 bytes/block, 256 values/block
        int nblocks = (p.I + 255) / 256;
        for (int bi = tid; bi < nblocks; bi += nth) {
            uint bo = uint(bi) * 84u;
            for (int j = 0; j < 256; j++) {
                int vi = bi * 256 + j;
                if (vi >= p.I) break;
                sum += (staged ? xsh[vi] : x[xoff + vi]) * dequant_q2_K(rowBase, bo, j);
            }
        }
    } else if (p.fmt == 11) {
        // Q3_K: 110 bytes/block, 256 values/block
        int nblocks = (p.I + 255) / 256;
        for (int bi = tid; bi < nblocks; bi += nth) {
            uint bo = uint(bi) * 110u;
            for (int j = 0; j < 256; j++) {
                int vi = bi * 256 + j;
                if (vi >= p.I) break;
                sum += (staged ? xsh[vi] : x[xoff + vi]) * dequant_q3_K(rowBase, bo, j);
            }
        }
    }

    // Intra-subgroup reduction
    float tot = subgroupAdd(sum);
    if (lane == 0) sg_sum[sg] = tot;
    barrier();

    // Cross-subgroup reduction
    int nsubgroups = nth / sgsize;
    if (sg == 0) {
        float final = 0.0;
        for (int si = lane; si < nsubgroups; si += sgsize) final += sg_sum[si];
        final = subgroupAdd(final);
        if (lane == 0) y[s * p.O + o] = final;
    }
}
