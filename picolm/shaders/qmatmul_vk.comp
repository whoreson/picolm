#version 450
// Scalar dequant matmul: Y[s,o] = sum_i X[s,i] * W[o,i]
// Grid: [O, S, 1], block: [256, 1, 1]
// Each thread computes the full dot product (no shared memory, no barriers).
// This is redundant but correct on all hardware including KAVERI.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) readonly buffer W  { uint  w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int fmt;
    int S, I, O;
    int rowWords;
} p;

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

uint read_byte(uint rowBase, uint byteOff) {
    uint wIdx = rowBase + byteOff / 4u;
    return (w[wIdx] >> ((byteOff % 4u) * 8u)) & 0xffu;
}

void main() {
    int s   = int(gl_WorkGroupID.y);
    int o   = int(gl_WorkGroupID.x);
    int xoff = s * p.I;
    uint rowBase = uint(o) * uint(p.rowWords);
    float sum = 0.0;

    if (p.fmt == 8) {
        // Q8_0: each block is [d:F16][qs:32xI8] = 34 bytes
        int nblocks = (p.I + 31) / 32;
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 34u;
            uint dWord = rowBase + bo / 4u;
            uint dShift = (bo % 4u) * 8u;
            float d = f16tof32((w[dWord] >> dShift) & 0xffffu);
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v;
                if (vi >= p.I) break;
                uint bv = read_byte(rowBase, bo + 2u + uint(v));
                int val = int(bv); if (val >= 128) val -= 256;
                sum += x[xoff + vi] * float(val) * d;
            }
        }
    } else if (p.fmt == 2) {
        // Q4_0: each block is [d:F16][qs:16xU8] = 18 bytes, 32 values
        int nblocks = (p.I + 31) / 32;
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 18u;
            float d = f16tof32(read_byte(rowBase, bo) | (read_byte(rowBase, bo+1u) << 8u));
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v;
                if (vi >= p.I) break;
                uint ni = v < 16 ? uint(v) : uint(v - 16);
                uint bv = read_byte(rowBase, bo + 2u + ni);
                int val = int((bv >> (v < 16 ? 0u : 4u)) & 0xfu) - 8;
                sum += x[xoff + vi] * float(val) * d;
            }
        }
    } else if (p.fmt == 1) {
        // F16 weights
        for (int i = 0; i < p.I; i++) {
            uint h = read_byte(rowBase, uint(i)*2u) | (read_byte(rowBase, uint(i)*2u+1u) << 8u);
            sum += x[xoff + i] * f16tof32(h);
        }
    } else if (p.fmt == 0) {
        // F32 weights (stored as uint32 in the uint buffer)
        for (int i = 0; i < p.I; i++) {
            sum += x[xoff + i] * uintBitsToFloat(w[rowBase + uint(i)]);
        }
    } else if (p.fmt == 3) {
        // Q5_0: each block is [d:F16][qs:16xU8][qh:32 bits] = 22 bytes, 32 values
        int nblocks = (p.I + 31) / 32;
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 22u;
            float d = f16tof32(read_byte(rowBase, bo) | (read_byte(rowBase, bo+1u) << 8u));
            // Read 32-bit qh
            uint qh = read_byte(rowBase, bo+2u) | (read_byte(rowBase, bo+3u) << 8u) |
                      (read_byte(rowBase, bo+4u) << 16u) | (read_byte(rowBase, bo+5u) << 24u);
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v;
                if (vi >= p.I) break;
                uint ni = v < 16 ? uint(v) : uint(v - 16);
                uint bv = read_byte(rowBase, bo + 6u + ni);
                int val = int((bv >> (v < 16 ? 0u : 4u)) & 0xfu);
                val = (val << 1u) | (int((qh >> v) & 1u));
                val -= 16;
                sum += x[xoff + vi] * float(val) * d;
            }
        }
    } else {
        // Unknown format: treat as zero
        sum = 0.0;
    }

    // Each thread writes independently (only one thread per output element)
    y[s * p.O + o] = sum;
}

