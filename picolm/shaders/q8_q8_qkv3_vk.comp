#version 450
// Fused QKV: single dispatch for Q, K, V projections
// Each thread computes one output element across all three projections
// Grid: [ceil(S*(Oq+Ok+Ov)/256), 1, 1], local_size_x = 256
//
// Binding 0: XQ (uint, packed int8 activations, shared)
// Binding 1: XD (float, activation deltas)
// Binding 2: WQ (uint, packed Q8_0 Q weights)
// Binding 3: WK (uint, packed Q8_0 K weights)
// Binding 4: WV (uint, packed Q8_0 V weights)
// Binding 5: YQ (float, Q output)
// Binding 6: YK (float, K output)
// Binding 7: YV (float, V output)

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer B_XQ { uint xq[]; };
layout(std430, binding = 1) readonly buffer B_XD { float xd[]; };
layout(std430, binding = 2) readonly buffer B_WQ { uint wq[]; };
layout(std430, binding = 3) readonly buffer B_WK { uint wk[]; };
layout(std430, binding = 4) readonly buffer B_WV { uint wv[]; };
layout(std430, binding = 5) writeonly buffer B_YQ { float yq[]; };
layout(std430, binding = 6) writeonly buffer B_YK { float yk[]; };
layout(std430, binding = 7) writeonly buffer B_YV { float yv[]; };

layout(push_constant) uniform P {
    int I, S, Oq, Ok, Ov;
    int rwQ, rwK, rwV;  // row_words for Q, K, V weight tensors
} p;

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    int S = p.S, I = p.I, Oq = p.Oq, Ok = p.Ok, Ov = p.Ov;
    int total_O = Oq + Ok + Ov;
    int total = S * total_O;
    if (gid >= uint(total)) return;

    int out_idx = int(gid);
    int s = out_idx / total_O;
    int o = out_idx % total_O;

    int nblocks = I / 32;
    uint xq_base = uint(s) * uint(I) / 4u;
    int xd_base = s * nblocks;
    float sum = 0.0;

    if (o < Oq) {
        // Q projection
        int oq = o;
        uint rowBase = uint(oq) * uint(p.rwQ);
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 34u;
            float wd = f16tof32((wq[rowBase + bo/4u] >> ((bo%4u)*8u)) & 0xffffu);
            float scale = wd * xd[xd_base + bi];
            uint aqs_base = xq_base + uint(bi) * 8u;
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v; if (vi >= I) break;
                int wi = int((wq[rowBase + (bo+2u+uint(v))/4u] >> (((bo+2u+uint(v))%4u)*8u)) & 0xffu);
                if (wi >= 128) wi -= 256;
                int ai = int((xq[aqs_base + uint(v)/4u] >> ((uint(v)%4u)*8u)) & 0xffu);
                if (ai >= 128) ai -= 256;
                sum += float(wi) * float(ai) * scale;
            }
        }
        yq[s * Oq + oq] = sum;
    } else if (o < Oq + Ok) {
        // K projection
        int ok = o - Oq;
        uint rowBase = uint(ok) * uint(p.rwK);
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 34u;
            float wd = f16tof32((wk[rowBase + bo/4u] >> ((bo%4u)*8u)) & 0xffffu);
            float scale = wd * xd[xd_base + bi];
            uint aqs_base = xq_base + uint(bi) * 8u;
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v; if (vi >= I) break;
                int wi = int((wk[rowBase + (bo+2u+uint(v))/4u] >> (((bo+2u+uint(v))%4u)*8u)) & 0xffu);
                if (wi >= 128) wi -= 256;
                int ai = int((xq[aqs_base + uint(v)/4u] >> ((uint(v)%4u)*8u)) & 0xffu);
                if (ai >= 128) ai -= 256;
                sum += float(wi) * float(ai) * scale;
            }
        }
        yk[s * Ok + ok] = sum;
    } else {
        // V projection
        int ov = o - Oq - Ok;
        uint rowBase = uint(ov) * uint(p.rwV);
        for (int bi = 0; bi < nblocks; bi++) {
            uint bo = uint(bi) * 34u;
            float wd = f16tof32((wv[rowBase + bo/4u] >> ((bo%4u)*8u)) & 0xffffu);
            float scale = wd * xd[xd_base + bi];
            uint aqs_base = xq_base + uint(bi) * 8u;
            for (int v = 0; v < 32; v++) {
                int vi = bi * 32 + v; if (vi >= I) break;
                int wi = int((wv[rowBase + (bo+2u+uint(v))/4u] >> (((bo+2u+uint(v))%4u)*8u)) & 0xffu);
                if (wi >= 128) wi -= 256;
                int ai = int((xq[aqs_base + uint(v)/4u] >> ((uint(v)%4u)*8u)) & 0xffu);
                if (ai >= 128) ai -= 256;
                sum += float(wi) * float(ai) * scale;
            }
        }
        yv[s * Ov + ov] = sum;
    }
}
