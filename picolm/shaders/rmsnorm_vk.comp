#version 450
// RMS norm: y[s,i] = x[s,i] * w[i] / sqrt(mean(x[s,:]^2) + eps)
// NO shared memory, NO subgroup ops -- safe for KAVERI/MI50.
// Push constant layout matches matmul (PC_Matmul): fmt, S, I(D), O, rowWords(x_stride)

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) readonly buffer W  { float w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    int fmt;       // unused
    int S;         // number of rows
    int I;         // dimension D
    int O;         // unused
    int rowWords;  // x_stride (0 = D)
} p;

void main() {
    int s = int(gl_WorkGroupID.x);
    if (s >= p.S) return;
    int tid = int(gl_LocalInvocationID.x);
    int D = p.I;
    int stride = p.rowWords > 0 ? p.rowWords : D;
    uint base = uint(s) * uint(stride);

    // Every thread computes the full sum of squares
    float sum_sq = 0.0;
    for (int i = 0; i < D; i++) {
        float v = x[base + uint(i)];
        sum_sq += v * v;
    }
    float r = 1.0 / sqrt(sum_sq / float(D) + 1e-5);

    // All threads write their assigned outputs
    for (int i = tid; i < D; i += 256)
        y[base + uint(i)] = x[base + uint(i)] * r * w[i];
}

