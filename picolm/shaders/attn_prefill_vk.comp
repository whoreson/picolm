#version 450
// Prefill attention: multi-head causal attention over cached KV
// Grid: [ceil(n_heads*n_tokens/256), 1, 1], block: [256, 1, 1]
// Each thread handles one (head, token) pair independently.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer B_Q { float q_data[]; };
layout(set = 0, binding = 1, std430) readonly buffer B_KK { float kv_k_data[]; };
layout(set = 0, binding = 2, std430) readonly buffer B_KV { float kv_v_data[]; };
layout(set = 0, binding = 3, std430) writeonly buffer B_OUT { float xb_out[]; };

layout(push_constant) uniform PC {
    int layer_ordinal, start_pos, n_tokens, n_heads, n_kv_heads, head_dim;
    int max_seq_len, q_dim, pad0, pad1;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = uint(p.n_heads) * uint(p.n_tokens);
    if (gid >= total) return;

    int h  = int(gid % uint(p.n_heads));
    int qi = int(gid / uint(p.n_heads));

    int nkh = p.n_kv_heads;
    int hd  = p.head_dim;
    int kvh = h % nkh;
    int nt  = p.n_tokens;
    int sp  = p.start_pos;

    int q_stride = p.n_heads * hd;
    int kv_stride = nkh * hd;

    int q_off = qi * q_stride + h * hd;

    // Compute attention scores directly (no shared memory needed)
    float max_sc = -1e20;
    float scores[64];  // max 64 tokens for stack allocation safety
    int valid = 0;

    for (int ti = 0; ti < nt; ti++) {
        float s = 0.0;
        int k_off = ti * kv_stride + kvh * hd;
        for (int d = 0; d < hd; d++) {
            s += q_data[q_off + d] * kv_k_data[k_off + d];
        }
        s *= 0.125; // 1/sqrt(64) for head_dim=64
        scores[valid++] = s;
        if (s > max_sc) max_sc = s;
    }

    // Softmax + weighted V accumulation
    float inv = 0.0;
    float acc[64];
    for (int d = 0; d < hd; d++) acc[d] = 0.0;

    // First pass: compute exp and sum
    float sum_exp = 0.0;
    float exps[64];
    for (int ti = 0; ti < valid; ti++) {
        exps[ti] = exp(scores[ti] - max_sc);
        sum_exp += exps[ti];
    }

    if (sum_exp > 0.0) {
        inv = 1.0 / sum_exp;
        // Second pass: accumulate V weighted by softmax
        for (int ti = 0; ti < valid; ti++) {
            float w = exps[ti] * inv;
            int v_off = ti * kv_stride + kvh * hd;
            for (int d = 0; d < hd; d++) {
                acc[d] += w * kv_v_data[v_off + d];
            }
        }
    }

    // Write output
    int o_off = qi * q_stride + h * hd;
    for (int d = 0; d < hd; d++) {
        xb_out[o_off + d] = acc[d];
    }
}

