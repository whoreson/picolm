#version 450
// Q8_0 x Q8_0 matmul: y[S][O] = xq[S][I] * xd[S][n_blocks] @ W[O][I]
// 256 threads per workgroup, pure shared-memory tree reduction.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer XQ { uint xq[]; };
layout(std430, binding = 1) readonly buffer XD { float xd[]; };
layout(std430, binding = 2) readonly buffer W  { uint  w[]; };
layout(std430, binding = 3) writeonly buffer Y  { float y[]; };

layout(push_constant) uniform P {
    int I;
    int S;
    int O;
    int rowWords;
} p;

shared float red[256];

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

void main() {
    int s   = int(gl_WorkGroupID.y);
    int tid = int(gl_LocalInvocationID.x);
    int o   = int(gl_WorkGroupID.x);

    int nblocks = p.I / 32;
    uint rowBase = uint(o) * uint(p.rowWords);
    uint xq_base = uint(s) * uint(p.I) / 4u;
    int xd_base = s * nblocks;

    float sum = 0.0;

    for (int bi = tid; bi < nblocks; bi += 256) {
        uint bo = uint(bi) * 34u;
        uint dWord = rowBase + bo / 4u;
        uint dShift = (bo % 4u) * 8u;
        float wd = f16tof32((w[dWord] >> dShift) & 0xffffu);
        float ad = xd[xd_base + bi];
        float scale = wd * ad;

        uint aqs_base = xq_base + uint(bi) * 8u;

        for (int v = 0; v < 32; v++) {
            int vi = bi * 32 + v;
            if (vi >= p.I) break;

            uint wbyte_off = rowBase + (bo + 2u + uint(v)) / 4u;
            uint wshift = ((bo + 2u + uint(v)) % 4u) * 8u;
            uint wbyte = (w[wbyte_off] >> wshift) & 0xffu;
            int wval = int(wbyte);
            if (wval >= 128) wval -= 256;

            uint ab_idx = aqs_base + uint(v) / 4u;
            uint abyte = (xq[ab_idx] >> ((uint(v) % 4u) * 8u)) & 0xffu;
            int aval = int(abyte);
            if (aval >= 128) aval -= 256;

            sum += float(wval) * float(aval) * scale;
        }
    }

    // Shared-memory tree reduction
    red[tid] = sum;
    barrier();
    for (int stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) red[tid] += red[tid + stride];
        barrier();
    }
    if (tid == 0) y[s * p.O + o] = red[0];
}
