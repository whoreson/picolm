#version 450
// Q8_0 x Q8_0 matrix multiplication on device.
// Input XQ:   [S][I/4] uint32 (packed int8 activations, 4 per word)
// Input XD:   [S][I/32] float32 (per-block activation deltas)
// Input W:    [O][I/32*36] uint32 (packed Q8_0 weight blocks, 36 bytes each)
// Output Y:   [S][y_stride] float32 (result, y_stride >= O)
//
// Push constants: int I, S, O, rowWords, y_stride = 20 bytes
// Binding 0: XQ (readonly uint)
// Binding 1: XD (readonly float)
// Binding 2: W  (readonly uint)
// Binding 3: Y  (writeonly float)
//
// Grid: [(O+63)/64, S, 1], Block: 64 threads
// Each thread computes one output element.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer XQ { uint xq[]; };
layout(std430, binding = 1) readonly buffer XD { float xd[]; };
layout(std430, binding = 2) readonly buffer W  { uint  w[]; };
layout(std430, binding = 3) writeonly buffer Y  { float y[]; };

layout(push_constant) uniform P {
    int I;
    int S;
    int O;
    int rowWords;
    int y_stride;
} p;

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

void main() {
    uint o = gl_GlobalInvocationID.x;
    uint s = gl_GlobalInvocationID.y;
    if (o >= uint(p.O)) return;
    
    int nblocks = p.I / 32;
    uint xq_words = uint(p.I) / 4u;
    uint rowBase = o * uint(p.rowWords);
    uint xq_base = uint(s) * xq_words;
    int xd_base = int(s) * nblocks;

    float sum = 0.0;

    // Q8_0 weights padded to 36 bytes/block during upload (word-aligned)
    for (int bi = 0; bi < nblocks; bi++) {
        uint bo = uint(bi) * 36u;
        uint dWord = rowBase + bo / 4u;
        uint dShift = (bo % 4u) * 8u;
        float wd = f16tof32((w[dWord] >> dShift) & 0xffffu);
        float ad = xd[xd_base + bi];
        float scale = wd * ad;
        uint aqs_base = xq_base + uint(bi) * 8u;
        
        // Optimized inner loop: accumulate int products, apply scale once
        float block_sum = 0.0;
        for (int v = 0; v < 32; v++) {
            uint wbyte_off = rowBase + (bo + 2u + uint(v)) / 4u;
            uint wshift = ((bo + 2u + uint(v)) % 4u) * 8u;
            uint wbyte = (w[wbyte_off] >> wshift) & 0xffu;
            int wval = int(wbyte << 24u); wval = wval >> 24u;
            uint ab_idx = aqs_base + uint(v) / 4u;
            uint abyte = (xq[ab_idx] >> ((uint(v) % 4u) * 8u)) & 0xffu;
            int aval = int(abyte << 24u); aval = aval >> 24u;
            block_sum += float(wval * aval);
        }
        sum += block_sum * scale;
    }
    y[uint(s) * uint(p.y_stride) + o] = sum;
}
