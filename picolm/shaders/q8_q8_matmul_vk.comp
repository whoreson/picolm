#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
// Q8_0 x Q8_0 matmul: y[S][O] = xq[S][I] * xd[S][n_blocks] @ W[O][I]
// All on device.
//
// xq: int8 activations packed as uint32 words [S][I]
// xd: float deltas [S][n_blocks] where n_blocks = I/32
// W:  Q8_0 weight blocks [O][n_blocks][34 bytes] stored as raw uint32 words
//
// Each workgroup = one (s, o) output element, 256 threads for reduction.
//
// Push constants: int I, int S, int O, int rowWords = 16 bytes
// Binding 0: readonly XQ (uint32-packed int8)
// Binding 1: readonly XD (float deltas)
// Binding 2: readonly W  (uint32-packed Q8_0 blocks)
// Binding 3: writeonly Y  (float)

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer XQ { uint xq[]; };
layout(std430, binding = 1) readonly buffer XD { float xd[]; };
layout(std430, binding = 2) readonly buffer W  { uint  w[]; };
layout(std430, binding = 3) writeonly buffer Y  { float y[]; };

layout(push_constant) uniform P {
    int I;
    int S;
    int O;
    int rowWords;
} p;

shared float sg_sum[8];

float f16tof32(uint h) {
    uint s = (h >> 15u) & 1u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 1023u;
    if (e == 0u) {
        if (m == 0u) return s != 0u ? -0.0 : 0.0;
        float v = float(m) * 5.960464477539063e-8;
        return s != 0u ? -v : v;
    }
    if (e == 31u) return s != 0u ? -1.0/0.0 : 1.0/0.0;
    uint bits = (s << 31u) | ((e - 15u + 127u) << 23u) | (m << 13u);
    return uintBitsToFloat(bits);
}

uint read_byte(uint rowBase, uint byteOff) {
    uint wIdx = rowBase + byteOff / 4u;
    return (w[wIdx] >> ((byteOff % 4u) * 8u)) & 0xffu;
}

void main() {
    int s   = int(gl_WorkGroupID.y);
    int tid = int(gl_LocalInvocationID.x);
    int nth = int(gl_WorkGroupSize.x);
    int sg      = int(gl_SubgroupID);
    int lane    = int(gl_SubgroupInvocationID);
    int sgsize  = int(gl_SubgroupSize);
    int o       = int(gl_WorkGroupID.x);

    if (o >= p.O || s >= p.S) return;

    int nblocks = p.I / 32;
    uint rowBase = uint(o) * uint(p.rowWords);
    uint xq_base = uint(s) * uint(p.I);
    int xd_base = s * nblocks;

    float sum = 0.0;

    for (int bi = tid; bi < nblocks; bi += nth) {
        uint bo = uint(bi) * 34u;
        uint dWord = rowBase + bo / 4u;
        uint dShift = (bo % 4u) * 8u;
        float wd = f16tof32((w[dWord] >> dShift) & 0xffffu);
        float ad = xd[xd_base + bi];
        float scale = wd * ad;

        uint wqs_base = rowBase + (bo + 2u) / 4u;
        uint aqs_base = xq_base + uint(bi) * 32u;

        for (int v = 0; v < 32; v++) {
            int vi = bi * 32 + v;
            if (vi >= p.I) break;

            uint wb_idx = wqs_base + uint(v) / 4u;
            uint wbyte = (w[wb_idx] >> ((uint(v) % 4u) * 8u)) & 0xffu;
            int wval = int(wbyte);
            if (wval >= 128) wval -= 256;

            uint ab_idx = aqs_base + uint(v) / 4u;
            uint abyte = (xq[ab_idx] >> ((uint(v) % 4u) * 8u)) & 0xffu;
            int aval = int(abyte);
            if (aval >= 128) aval -= 256;

            sum += float(wval) * float(aval) * scale;
        }
    }

    float tot = subgroupAdd(sum);
    if (lane == 0) sg_sum[sg] = tot;
    barrier();

    int nsubgroups = nth / sgsize;
    if (sg == 0) {
        float final = 0.0;
        for (int si = lane; si < nsubgroups; si += sgsize) final += sg_sum[si];
        final = subgroupAdd(final);
        if (lane == 0) y[s * p.O + o] = final;
    }
}

