#version 450
// LayerNorm: y[s,i] = (x[s,i] - mean) / sqrt(var + eps) * w[i] + b[i]
// Each thread computes full mean+var (no shared memory, safe for all GPUs)
// Push constant: PC_Matmul {fmt, S, I=dim, O=eps(bitcast), rowWords=stride}
// binding 0: X (input), 1: W (weight), 2: Y (output), 3: B (bias)

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(std430, binding = 3) readonly buffer B { float b[]; };

layout(push_constant) uniform P {
    int fmt;
    int S;
    int I;
    float eps;
    int rowWords;
} p;

void main() {
    int s = int(gl_WorkGroupID.x);
    if (s >= p.S) return;
    int tid = int(gl_LocalInvocationID.x);
    int D = p.I;
    if (D <= 0) return;
    int stride = p.rowWords > 0 ? p.rowWords : D;
    uint base = uint(s) * uint(stride);

    // Compute mean
    float mean = 0.0;
    for (int i = 0; i < D; i++) {
        mean += x[base + uint(i)];
    }
    mean /= float(D);

    // Compute variance
    float var = 0.0;
    for (int i = 0; i < D; i++) {
        float diff = x[base + uint(i)] - mean;
        var += diff * diff;
    }
    var /= float(D);
    float r = 1.0 / sqrt(var + p.eps);

    // Write output (parallelized across threads)
    for (int i = tid; i < D; i += 64)
        y[base + uint(i)] = (x[base + uint(i)] - mean) * r * w[i] + b[i];
}
