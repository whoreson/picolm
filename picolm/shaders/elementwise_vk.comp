#version 450
// Elementwise operations: residual_add, silu_mul, rope_apply, f32_to_f16, sigmoid_mul
// 4 STORAGE_BUFFER bindings, 20-byte push constant
//
// op=0: residual_add    bind0=a(ro), bind1=b(ro), bind2=out(rw), bind3=unused
// op=1: silu_mul        bind0=gate(rw), bind1=up(ro), bind2=gate(rw, same as 0), bind3=unused
// op=2: rope_apply      bind0=x(rw), bind1=cos(ro), bind2=sin(ro), bind3=unused
// op=3: f32_to_f16      bind0=src_f32(ro), bind1=unused, bind2=unused, bind3=dst_u32(rw)
// op=4: sigmoid_mul     bind0=out(rw), bind1=gate(ro), bind2=unused, bind3=unused
// op=7: gelu_inplace    bind0=x(rw), bind1=unused, bind2=unused, bind3=unused
// op=6: rope_batched    bind0=x(rw, strided), bind1=cos_table(ro, 2D), bind2=sin_table(ro, 2D), bind3=unused
//   2D dispatch: x=half_dim/256, y=S (n_tokens). Uses fp=n_heads, pad=start_pos.
//   cos_table layout: [max_positions][half_dim], accessed at row (start_pos + y)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer B0 { float d0[]; };
layout(set = 0, binding = 1) buffer B1 { float d1[]; };
layout(set = 0, binding = 2) buffer B2 { float d2[]; };
layout(set = 0, binding = 3) buffer B3 { uint d3[]; };

layout(push_constant) uniform PC {
    int op;
    int n;
    float fp;
    int pad;       /* op==6: start_pos; op==2: rope_type (legacy) */
    int pad2;      /* op==6: rope_type */
    int pad3;
    int pad4;
} pc;

uint f32tof16_bits(float v) {
    // Reinterpret float bits as uint via floatBitsToInt + bitcast
    // GLSL doesn't have uintBitsToUint, but we can use pack/unpack tricks
    // or just do the math directly:
    int iv = floatBitsToInt(v);
    // bitcast int to uint: just reinterpret the bits
    uint fv = bitfieldInsert(0u, uint(iv), 0, 32);
    uint sign = (fv >> 16u) & 0x8000u;
    uint exp = (fv >> 23u) & 0xffu;
    uint frac = fv & 0x7fffffu;
    if (exp == 0u) return sign;
    if (exp == 0xffu) return sign | 0x7c00u;
    int e = int(exp) - 127 + 15;
    if (e <= 0) return sign;
    if (e >= 31) return sign | 0x7c00u;
    return sign | uint(e) << 10u | (frac >> 13u);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;

    if (pc.op == 0) {
        if (gid < uint(pc.n)) d2[gid] = d0[gid] + d1[gid];
    } else if (pc.op == 1) {
        if (gid < uint(pc.n)) {
            float g = d0[gid];
            float silu_g = g / (1.0 + exp(-g));
            d0[gid] = silu_g * d1[gid];
        }
    } else if (pc.op == 2) {
        // RoPE decode: flattened over heads. gid covers half_dim * n_heads.
        // pc.pad carries rope_type, matching the CPU/GPU-CUDA convention:
        //   rope_type != 0  -> half-split (NEOX): pairs (x[g], x[g+half])
        //   rope_type == 0  -> pairwise (llama):  pairs (x[2g], x[2g+1])
        // The shader previously ignored rope_type and always applied the
        // pairwise form, so Qwen3.5/3.6 (which need half-split) were rotated
        // wrongly on the Vulkan backend even after the CPU/CUDA fix.
        uint hd2 = uint(pc.n);
        int n_heads = int(pc.fp);
        int rope_type = pc.pad2;
        int total = int(hd2) * n_heads;
        if (gid < total) {
            int h = int(gid) / int(hd2);
            int g = int(gid) % int(hd2);
            int stride = 2 * int(hd2);
            int base, i0, i1;
            if (rope_type != 0) {
                base = h * stride;
                i0 = base + g;
                i1 = base + g + int(hd2);
            } else {
                base = h * stride;
                i0 = base + 2 * g;
                i1 = base + 2 * g + 1;
            }
            float x0 = d0[i0];
            float x1 = d0[i1];
            float c = d1[g];
            float s = d2[g];
            d0[i0] = x0 * c - x1 * s;
            d0[i1] = x0 * s + x1 * c;
        }
    } else if (pc.op == 3) {
        // F32->F16 pack: each thread handles one output word (2 F16 values)
        uint word_gid = gid;
        uint idx0 = word_gid * 2u;
        if (idx0 < uint(pc.n)) {
            uint lo = f32tof16_bits(d0[idx0]);
            if (idx0 + 1u < uint(pc.n)) {
                uint hi = f32tof16_bits(d0[idx0 + 1u]);
                d3[word_gid] = lo | (hi << 16u);
            } else {
                d3[word_gid] = lo;
            }
        }
    } else if (pc.op == 4) {
        if (gid < uint(pc.n)) {
            d0[gid] *= 1.0 / (1.0 + exp(-d1[gid]));
        }
    } else if (pc.op == 7) {
        // GELU in-place: x = gelu(x)
        if (gid < uint(pc.n)) {
            float v = d0[gid];
            float gelu_v = 0.5 * v * (1.0 + tanh(0.79788456 * (v + 0.044715 * v * v * v)));
            d0[gid] = gelu_v;
        }
    } else if (pc.op == 6) {
        // Batched RoPE: flattened over heads. gid covers half_dim * n_heads.
        // y dimension = token index. No serial loop over heads.
        uint hd2 = uint(pc.n);
        int n_heads = int(pc.fp);
        int start_pos = pc.pad;
        int rope_type = pc.pad2;   /* 0 = pairwise, non-zero = half-split */
        int tok = int(gl_GlobalInvocationID.y);
        int hdim = int(hd2) * 2;
        int total = int(hd2) * n_heads;
        if (gid < total) {
            int h = int(gid) / int(hd2);
            int g = int(gid) % int(hd2);
            int cs_row = (start_pos + tok) * int(hd2);
            int hbase = tok * n_heads * hdim + h * hdim;
            int i0, i1;
            if (rope_type != 0) {
                /* NEOX / half-split: x[g] pairs with x[g + half] */
                i0 = hbase + g;
                i1 = hbase + g + int(hd2);
            } else {
                /* llama pairwise: x[2g] pairs with x[2g+1] */
                i0 = hbase + 2 * g;
                i1 = hbase + 2 * g + 1;
            }
            float x0 = d0[i0];
            float x1 = d0[i1];
            float c = d1[cs_row + g];
            float s = d2[cs_row + g];
            d0[i0] = x0 * c - x1 * s;
            d0[i1] = x0 * s + x1 * c;
        }
    }
}

