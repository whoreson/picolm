#version 450
// Decode attention: single-token causal attention over F16 KV cache
// Grid: [ceil(n_heads/256), 1, 1], block: [256, 1, 1]
// Each thread handles one head.
//
// KV cache layout: [layer_ordinal][max_seq_len][nkh * hd] of uint16_t
// std430 uint array: 2 F16 values packed per uint32 element
// F16 element index -> uint32 index: f16_idx / 2
// Extract: (f16_idx % 2 == 0) ? lower 16 bits : upper 16 bits

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer B_Q { float q_data[]; };
layout(set = 0, binding = 1, std430) readonly buffer B_KK { uint kv_k_data[]; };
layout(set = 0, binding = 2, std430) readonly buffer B_KV { uint kv_v_data[]; };
layout(set = 0, binding = 3, std430) writeonly buffer B_OUT { float xb_out[]; };

layout(push_constant) uniform PC {
    int lo;            // layer_ordinal (attention-layer index)
    int pos;           // current position (0-based, causal mask = pos+1)
    int nh;            // n_heads
    int nkh;           // n_kv_heads
    int hd;            // head_dim
    int msl;           // max_seq_len (for stride calculation)
    float inv_sqrt_hd; // 1/sqrt(head_dim)
    int n_swa;         // 0 = full causal attention; >0 = sliding-window
                        // size, restricting attention to the last n_swa
                        // positions (see model.h's n_swa_layer[]). Was an
                        // unused `pad` field.
} p;

// fp16 to fp32 conversion (matches attn_prefill_f16vk.comp exactly)
float u16tof32(uint v) {
    v &= 0xFFFFu;  // mask to 16 bits
    uint sign = (v >> 15) & 0x1;
    uint exp = (v >> 10) & 0x1F;
    uint frac = v & 0x3FF;
    if (exp == 0) {
        if (frac == 0) {
            uint r = (sign << 31);
            return uintBitsToFloat(r);
        }
        uint t = frac;
        int shift = 0;
        while ((t & 0x400u) == 0u) { t <<= 1; shift++; }
        t >>= 1;
        exp = 1 - shift + (127 - 15);
        frac = t & 0x3FF;
    } else if (exp == 31) {
        uint r = (sign << 31) | 0x7F800000u | ((frac != 0u) ? 1u : 0u);
        return uintBitsToFloat(r);
    } else {
        exp = exp - 15 + 127;
    }
    uint r = (sign << 31) | (exp << 23) | (frac << 13);
    return uintBitsToFloat(r);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.nh)) return;

    int h = int(gid);
    int nkh = p.nkh;
    int hd = p.hd;
    int msl = p.msl;
    int kv_mul = p.nh / nkh;
    int kvh = h / kv_mul;

    // KV cache layout: [layer][seq][nkh*hd] of uint16_t (2 bytes each)
    // std430 uint array: each element is 4 bytes (uint32)
    // F16 index -> uint32 index: f16_idx / 2
    int kv_base = p.lo * msl * nkh * hd;  // F16 element offset for this layer
    int kv_row = nkh * hd;  // F16 elements per sequence position

    int q_off = h * hd;
    int out_off = h * hd;

    // Causal + sliding-window: attend to positions [win_start .. pos].
    // win_start is 0 for every non-SWA layer/model (n_swa == 0), which is
    // exactly the old, pre-SWA behavior -- strict no-op for those.
    int win_start = (p.n_swa > 0) ? max(0, p.pos - p.n_swa + 1) : 0;
    int n_kv = p.pos - win_start + 1;

    float max_sc = -1e20f;
    float scores[512];

    // Q @ K^T pass
    for (int ti = win_start; ti <= p.pos; ti++) {
        int si = ti - win_start; // scores[]/acc index, always 0-based
        float s = 0.0f;
        for (int d = 0; d < hd; d++) {
            int f16_idx = kv_base + ti * kv_row + kvh * hd + d;
            uint packed = kv_k_data[f16_idx >> 1];
            uint f16val = ((f16_idx & 1) != 0) ? (packed >> 16) : (packed & 0xFFFFu);
            s += q_data[q_off + d] * u16tof32(f16val);
        }
        s *= p.inv_sqrt_hd;
        scores[si] = s;
        if (s > max_sc) max_sc = s;
    }

    // Softmax (two-pass: max-then-exp)
    float sum_exp = 0.0f;
    for (int si = 0; si < n_kv; si++) {
        scores[si] = exp(scores[si] - max_sc);
        sum_exp += scores[si];
    }
    if (sum_exp < 1e-10f) sum_exp = 1e-10f;
    float inv_sum = 1.0f / sum_exp;

    // Weighted V accumulation
    float acc[128];
    for (int d = 0; d < hd; d++) acc[d] = 0.0f;

    for (int ti = win_start; ti <= p.pos; ti++) {
        int si = ti - win_start;
        float e = scores[si];
        for (int d = 0; d < hd; d++) {
            int f16_idx = kv_base + ti * kv_row + kvh * hd + d;
            uint packed = kv_v_data[f16_idx >> 1];
            uint f16val = ((f16_idx & 1) != 0) ? (packed >> 16) : (packed & 0xFFFFu);
            acc[d] += e * u16tof32(f16val);
        }
    }

    // Normalize and write output
    for (int d = 0; d < hd; d++) {
        xb_out[out_off + d] = acc[d] * inv_sum;
    }
}
