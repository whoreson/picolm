#version 450

layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer B_Q { float q_data[]; };
layout(set = 0, binding = 1, std430) readonly buffer B_KK { float kv_k_data[]; };
layout(set = 0, binding = 2, std430) readonly buffer B_KV { float kv_v_data[]; };
layout(set = 0, binding = 3, std430) writeonly buffer B_OUT { float xb_out[]; };

layout(push_constant) uniform PC {
    int layer_ordinal, pos;
    int n_heads, n_kv_heads, head_dim;
    int max_seq_len, pad;
} p;

void main() {
    int h = int(gl_WorkGroupID.x);

    if (h >= p.n_heads) return;

    int kv_h = h / (p.n_heads / p.n_kv_heads);
    float attn_scale = 1.0 / sqrt(float(p.head_dim));

    int q_off = h * p.head_dim;
    int out_off = h * p.head_dim;

    int tokens_stride = p.n_kv_heads * p.head_dim;
    int head_stride = p.head_dim;
    int n_kv = p.pos + 1;

    // Compute QK dot products (serial)
    float max_s = -1e30;
    float scores[512];  // max seq_len

    for (int kp = 0; kp < n_kv; kp++) {
        int k_base = kp * tokens_stride + kv_h * head_stride;
        float sqk = 0.0;
        for (int d = 0; d < p.head_dim; d++) {
            sqk += q_data[q_off + d] * kv_k_data[k_base + d];
        }
        sqk *= attn_scale;
        scores[kp] = sqk;
        if (sqk > max_s) max_s = sqk;
    }

    float sum_w = 0.0;
    for (int kp = 0; kp < n_kv; kp++) {
        scores[kp] = exp(scores[kp] - max_s);
        sum_w += scores[kp];
    }
    if (sum_w < 1e-10) sum_w = 1e-10;
    float inv_sum = 1.0 / sum_w;

    // V accumulation
    for (int d = 0; d < p.head_dim; d++) {
        float acc = 0.0;
        for (int kp = 0; kp < n_kv; kp++) {
            int v_base = kp * tokens_stride + kv_h * head_stride;
            acc += kv_v_data[v_base + d] * scores[kp];
        }
        xb_out[out_off + d] = acc * inv_sum;
    }
}
