#version 450
// Quantize F32 activations to Q8_0 block format on device.
// PURE PER-THREAD: no shared memory, no barriers.
// Each workgroup (256 threads) handles one 32-value block of one activation row.
// Thread 0 computes the max abs and writes the d_val.
// All 32 threads quantize their own element and write directly to QS output.
//
// Input x:     [S][I] float32, contiguous
// Output qs:   [S][n_blocks][8] uint32 (32 int8 values packed as 8 uint32 words)
// Output d:    [S][n_blocks] float32
//
// Push constants: int I, int S, int pad (zero) = 12 bytes
// Binding 0: readonly X (float)
// Binding 1: writeonly QS (uint32 words)
// Binding 2: writeonly D  (float)
//
// Grid: [n_blocks, S, 1], Block: 256 threads

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) writeonly buffer QS { uint qs[]; };
layout(std430, binding = 2) writeonly buffer D  { float d[]; };

layout(push_constant) uniform P {
    int I;
    int S;
    int pad;
} p;

void main() {
    uint blk = gl_WorkGroupID.x;
    uint s   = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    uint n_blocks = (uint(p.I) + 31u) / 32u;
    if (blk >= n_blocks || s >= uint(p.S)) return;

    uint base = s * uint(p.I) + blk * 32u;
    int valid = p.I - int(blk) * 32;
    if (valid <= 0) return;

    // Step 1: Thread 0 scans all 32 elements to find max abs
    // All other threads do nothing for this step
    float amax0 = 0.0;
    if (tid == 0u) {
        for (uint i = 0; i < 32u; i++) {
            if (i >= uint(valid)) break;
            float v = x[base + i];
            float av = abs(v);
            if (av > amax0) amax0 = av;
        }
    }

    // Broadcast amax0 to all threads via a simple per-thread recompute
    // (avoids shared memory entirely)
    amax0 = 0.0;
    for (uint i = 0; i < 32u; i++) {
        if (i >= uint(valid)) break;
        float v = x[base + i];
        float av = abs(v);
        if (av > amax0) amax0 = av;
    }

    // Step 2: Compute scale
    float d_val = amax0 / 127.0;
    float id = (d_val > 0.0) ? (1.0 / d_val) : 0.0;

    // Step 3: Thread 0 writes the d_val
    if (tid == 0u) {
        d[s * n_blocks + blk] = d_val;
    }

    // Step 4: Threads 0-31 each quantize their element and write packed
    // Each thread reads all 4 values that belong to its uint32 word,
    // then writes the combined word to QS. 8 threads do this.
    uint widx = tid;
    if (widx < 8u) {
        uint out_base = (s * n_blocks * 32u + blk * 32u) / 4u;
        uint packed = 0u;
        for (uint b = 0u; b < 4u; b++) {
            uint val_idx = widx * 4u + b;
            if (val_idx >= 32u || val_idx >= uint(valid)) {
                // Padding byte = 0 (sign bit clear for int8)
                continue;
            }
            float v = x[base + val_idx];
            float qs_val = v * id;
            int qi = int(qs_val + (qs_val >= 0.0 ? 0.5 : -0.5));
            qi = clamp(qi, -128, 127);
            uint byte_val = uint(qi & 0xffu);
            packed |= byte_val << (b * 8u);
        }
        qs[out_base + widx] = packed;
    }
}
