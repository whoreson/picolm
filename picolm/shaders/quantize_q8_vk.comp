#version 450
// Quantize F32 activations to Q8_0 block format on device.
// PURE PER-THREAD: no shared memory, no barriers.
// Each workgroup handles one 32-value block of one activation row.
//
// Input x:     [S][x_stride] float32, only first I elements per row are valid.
//              x_stride MUST match the actual buffer stride (e.g. xb_stride for
//              GPT-2 where xb_stride=4800 > I=1600). Using s*I instead of
//              s*x_stride causes token 1+ to read garbage (root cause, Sep 2025).
// Output qs:   [S][n_blocks][8] uint32 (32 int8 values packed as 8 uint32 words)
// Output d:    [S][n_blocks] float32
//
// Push constants: int I, int S, int x_stride = 12 bytes
// Binding 0: readonly X (float)
// Binding 1: writeonly QS (uint32 words)
// Binding 2: writeonly D  (float)
//
// Grid: [n_blocks, S, 1], Block: 8 threads (each writes one packed uint32)
// All 8 threads independently compute amax (32 loads each = 256 total per block).
// Acceptable trade-off to avoid shared memory / barriers.

layout(local_size_x = 8) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };
layout(std430, binding = 1) writeonly buffer QS { uint qs[]; };
layout(std430, binding = 2) writeonly buffer D  { float d[]; };

layout(push_constant) uniform P {
    int I;
    int S;
    int x_stride;
} p;

void main() {
    uint blk = gl_WorkGroupID.x;
    uint s   = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    uint n_blocks = (uint(p.I) + 31u) / 32u;
    if (blk >= n_blocks || s >= uint(p.S)) return;

    uint base = uint(s) * uint(p.x_stride) + blk * 32u;
    int valid = p.I - int(blk) * 32;
    if (valid <= 0) return;

    // Each thread computes amax over all 32 elements.
    // 8 threads * 32 loads = 256 loads per block (vs 32 with shared mem).
    // Trade-off: no shared memory or barriers needed.
    float amax0 = 0.0f;
    for (uint i = 0u; i < uint(valid); i++) {
        float av = abs(x[base + i]);
        if (av > amax0) amax0 = av;
    }

    // Compute scale (use 127.0/amax for better precision, matches CPU/GPU)
    float id = (amax0 > 0.0) ? (127.0 / amax0) : 0.0;

    // Thread 0 writes the d_val
    if (tid == 0u) {
        d[s * n_blocks + blk] = amax0 / 127.0;
    }

    // Each of 8 threads quantizes 4 elements and writes one packed uint32
    uint out_base = (s * n_blocks * 32u + blk * 32u) / 4u;
    uint packed = 0u;
    for (uint b = 0u; b < 4u; b++) {
        uint val_idx = tid * 4u + b;
        if (val_idx >= 32u || val_idx >= uint(valid)) {
            // Padding byte = 0 (sign bit clear for int8)
            continue;
        }
        float v = x[base + val_idx];
        int qi = int(round(v * id));
        qi = clamp(qi, -127, 127);
        uint byte_val = uint(qi & 0xffu);
        packed |= byte_val << (b * 8u);
    }
    qs[out_base + tid] = packed;
}
